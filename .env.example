# Lumen Auction — local env example (T1)
# Secrets NEVER go in git, issues, PRs, commits, logs, or screenshots.
# CI/deploy values live in GitHub Secrets. This file holds placeholders only.

# --- Auth (§8 security baseline) ---
ENABLE_DEV_LOGIN=true                    # MUST be false outside dev environments
JWT_SECRET=change-me-local-only          # non-local startup FAILS if left at this value
FRONTEND_ORIGIN=http://localhost:8080    # WS Origin allowlist (CSWSH guard)

# --- Datastores ---
MYSQL_DSN=lumen:lumen@tcp(mysql:3306)/lumen?parseTime=true&loc=UTC&charset=utf8mb4
REDIS_ADDR=redis:6379

# --- AI sidecar (mock in T1; real Doubao in T7) ---
AI_SIDECAR_URL=http://ai-sidecar:8090
DOUBAO_API_KEY=                          # challenge-provided; never commit a real value
DOUBAO_ENDPOINT_ID=ep-xxxxxxxxxxxx-placeholder   # SCRUBBED placeholder; real id -> GitHub Secrets
AI_MODEL_NAME=Doubao-Seed-2.0-lite

# --- Server ---
HTTP_ADDR=:8080
APP_ENV=dev                              # dev | staging | prod (gates dev-login + JWT check)
LOG_REDACTION=true
