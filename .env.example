# Lumen Auction environment template.
# This file is a template only.
# Put real values in local `.env` and never commit them.
# CI/deploy values must live in GitHub Secrets.
# Never paste secrets into issues, PRs, commits, logs, or screenshots.

NODE_ENV=development # Runtime mode for local development
PORT=3000 # Backend HTTP and WebSocket port
APP_PUBLIC_URL=http://localhost:3000 # Public backend URL for callbacks and demos
FRONTEND_ORIGIN=http://localhost:5173 # Allowed local frontend origin

MYSQL_DSN=lumen:lumen@tcp(localhost:3306)/lumen?parseTime=true&loc=UTC&charset=utf8mb4 # MySQL DSN (legacy: MYSQL_URL can also be mysql://user:pass@host:port/db)
REDIS_ADDR=localhost:6379 # Redis host:port for Lua, Streams, and cache
# Optional legacy URL forms: REDIS_URL=redis://host:port/0 or rediss://:pass@host:port/0 (or use REDIS_PASSWORD)
REDIS_PASSWORD= # Set when Redis uses AUTH (cloud managed/credentialed instances)

JWT_SECRET=change-me-local-only # Local JWT signing secret; replace outside git
SESSION_COOKIE_NAME=lumen_session # Browser session cookie name
EVIDENCE_HMAC_KEY=change-me-evidence-local-only # T4 hash-chain HMAC key; set a real value outside dev, hold OUTSIDE the events DB (§6)

DOUBAO_API_KEY= # Challenge-provided shared key; never commit a real value
DOUBAO_ENDPOINT_ID=ep-your-endpoint-id # PDF section 7 Doubao endpoint id; never commit a real value
AI_MODEL_NAME=Doubao-Seed-2.0-lite # PDF section 7 supported model
AI_TIMEOUT_MS=2000 # AI Sidecar timeout before fallback copy
AI_MOCK_MODE=false # true returns mock AI output without provider calls
AI_FALLBACK_TEXT="AI assistant temporarily unavailable." # Safe fallback copy

LOG_LEVEL=info # Application log level
REQUEST_LOG_REDACTION=true # Keep secrets and auth headers out of logs
METRICS_ENABLED=true # Enable local operational metrics
LOAD_TEST_ENABLED=false # Keep load scripts opt-in by default
