{
  "description": "AI Sidecar — Doubao calls, token cost, fallback rate, guardrail hits. Maps to rubric AI 使用与落地.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuit state",
      "description": "0=closed, 1=half-open, 2=open (red = AI offline, bidding unaffected)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ai_circuit_state", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "HALF-OPEN", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "OPEN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens / min (last 5m avg)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(ai_tokens_total[5m])) * 60", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cost (¥, cumulative)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ai_cost_cents_total / 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyCNY" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ban-word hits (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "increase(ai_banwords_hits_total[5m])", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Facts latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(ai_facts_latency_seconds_bucket[1m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_facts_latency_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Auctioneer latency by kind",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(ai_auctioneer_latency_seconds_bucket[1m])))", "legendFormat": "{{kind}} p95", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors by phase",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (phase) (rate(ai_facts_errors_total[1m]))", "legendFormat": "facts {{phase}}", "refId": "A" },
        { "expr": "sum by (phase, kind) (rate(ai_auctioneer_errors_total[1m]))", "legendFormat": "auctioneer {{kind}}/{{phase}}", "refId": "B" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["lumen", "ai-sidecar", "rubric:ai"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Lumen Auction — AI Sidecar",
  "uid": "lumen-ai-sidecar",
  "version": 1
}
