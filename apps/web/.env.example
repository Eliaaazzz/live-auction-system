# Lumen Auction · frontend env (copy to .env.local, then edit)
# Vite reads VITE_* prefixed vars at build time.

# REST base — used by src/lib/api.js. Vite proxies /api/* to this host in dev.
VITE_API_BASE=http://localhost:8080

# WebSocket base — used by src/lib/ws.js. Vite proxies /ws to this host in dev.
VITE_WS_BASE=ws://localhost:8080

# Feature flags
VITE_USE_MOCK_DATA=true     # true: render from demo data · false: hit real backend
VITE_ENABLE_TWEAKS=true     # show in-page Tweaks panel for QA / design review

# Build info — surfaced in the AdminVLMFacts trust pill etc.
VITE_BUILD_SHA=dev
