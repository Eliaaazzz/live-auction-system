# Lumen Auction · frontend env (copy to .env.local only if you need to override)
# Vite reads VITE_* prefixed vars at build time.

# ─── Backend target ────────────────────────────────────────────────────
# In dev, leave the two BASE vars BLANK. The Vite proxy (vite.config.js)
# forwards /api/* and /ws to http://localhost:8080 by default, and the
# client uses same-origin URLs so the browser's Origin header matches the
# backend's FRONTEND_ORIGIN allowlist (§8 CSWSH guard, see
# proto/security-baseline.md).
#
# If you set VITE_WS_BASE to a non-empty value, src/routes/LiveRoomRoute.jsx
# builds the WS URL pointing at that host directly, bypassing the proxy.
# In that case the backend must have FRONTEND_ORIGIN set to YOUR frontend's
# origin (e.g. http://localhost:5173) or the WS upgrade is rejected with
# HTTP 401 unauthorized.
#
# VITE_API_BASE — proxy target inside vite.config.js (NOT consumed by
#                 src/lib/api.js, which always uses path /api/*). Leave
#                 blank to default to http://localhost:8080.
# VITE_WS_BASE  — both proxy target AND directly read by LiveRoomRoute.jsx.
#                 Leave blank to use same-origin (recommended in dev).
#
# Set both for PRODUCTION builds against your real backend:
# VITE_API_BASE=https://api.example.com
# VITE_WS_BASE=wss://api.example.com

# ─── Feature flags ─────────────────────────────────────────────────────
VITE_USE_MOCK_DATA=true     # true: render from demo data · false: hit real backend
VITE_ENABLE_TWEAKS=true     # show in-page Tweaks panel for QA / design review

# ─── Build info ────────────────────────────────────────────────────────
VITE_BUILD_SHA=dev          # surfaced in AdminVLMFacts trust pill etc.
